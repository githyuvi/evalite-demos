# Which LLM judges step-by-step reasoning quality: gemini or deepseek
JUDGE_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-key-here
JUDGE_GEMINI_MODEL=gemini-3.1-flash-lite

DEEPSEEK_API_KEY=your-deepseek-key-here
JUDGE_DEEPSEEK_MODEL=deepseek-v4-flash

# Where math-solver-agent's backend is running
MATH_AGENT_URL=http://localhost:8000

# Where to persist results — math-agent-eval-ui reads this same file
EVAL_DB_PATH=evalite.db

# How many conversations run concurrently. Lower this if you're hitting
# 429 Too Many Requests on a free-tier key — each conversation makes both
# a solver call (to math-solver-agent) and a judge call (below) per turn,
# so concurrency multiplies request rate quickly.
MAX_WORKERS=4

# Retry/backoff for transient HTTP failures (429/500/502/503/504, timeouts,
# connection errors) — applies to both the judge LLM calls and the call
# into math-solver-agent's backend. If you're still hitting 429s with the
# defaults, raise RETRY_MAX_ATTEMPTS and/or RETRY_BASE_DELAY_SECONDS (rate
# limits often need tens of seconds to clear, not sub-second backoff), or
# lower MAX_WORKERS above.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
