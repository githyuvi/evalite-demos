# Which provider to use: gemini or deepseek
LLM_PROVIDER=gemini

# Gemini (https://ai.google.dev) — gemini-2.5-flash-lite is no longer
# available to new API keys (404 on generate calls despite still showing up
# in ListModels). gemini-3.1-flash-lite is the current cheap tier and
# confirmed working.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# DeepSeek (https://platform.deepseek.com) — cheapest current model: $0.14/1M
# cache-miss input, $0.0028/1M cache-hit input, $0.28/1M output.
# NOTE: the old "deepseek-chat"/"deepseek-reasoner" aliases were retired
# 2026-07-24 and no longer resolve to any model.
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
